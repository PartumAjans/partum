# ----------------------------------------------------------------------------
# Partum Panel - Ortam Değişkenleri
# Bu dosyayı ".env.local" olarak kopyalayın ve değerleri doldurun.
# ----------------------------------------------------------------------------

# DEMO MODU
# true  -> Supabase/Meta gerekmez. Örnek verilerle panel çalışır (tasarım/önizleme için).
# false -> Gerçek Supabase girişi ve Meta API verisi kullanılır.
DEMO_MODE=true

# Oturum çerezlerini imzalamak için gizli anahtar (rastgele uzun bir metin girin).
# Üretimde MUTLAKA değiştirin: `openssl rand -base64 32`
AUTH_SECRET=degistir-bunu-uzun-rastgele-bir-anahtar

# ----------------------------------------------------------------------------
# META MARKETING API (DEMO_MODE=false iken gerekli)
# ----------------------------------------------------------------------------
# Business Manager > System User üzerinden oluşturulan kalıcı erişim token'ı.
# İzinler: ads_read (ve gerekirse ads_management).
META_ACCESS_TOKEN=
# Graph API sürümü
META_API_VERSION=v21.0

# ----------------------------------------------------------------------------
# SUPABASE (DEMO_MODE=false iken gerekli)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sunucu tarafı işlemler (kullanıcı-hesap eşleştirme) için servis anahtarı.
SUPABASE_SERVICE_ROLE_KEY=
